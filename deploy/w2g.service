[Unit]
Description=w2g / graph.global API (FastAPI + uvicorn, SQLite)
After=network.target

[Service]
User=mek
Group=mek
WorkingDirectory=/srv/graph.global
Environment=DATABASE_URL=sqlite:////srv/graph.global/data/w2g.db
ExecStart=/srv/graph.global/.venv/bin/uvicorn asgi:app --host 127.0.0.1 --port 8092 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
